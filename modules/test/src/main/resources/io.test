            i += 1
            tmp_input = ""
            data_type = "abcd"
            while i < len(user_input) and user_input[i] in data_type:
                tmp_input += user_input[i]
                i += 1
            y = tmp_input[0: 2]
        java:
            char x;
            String y = "";
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            String tmpInput;
            int i;
            String dataType;
            userInput = scanner.nextLine();
            i = 0;
            x = userInput.charAt(i++);
            tmpInput = "";
            dataType = "abcd";
            while (i < userInput.length() && dataType.indexOf(userInput.charAt(i)) != -1) {
                tmpInput += userInput.charAt(i++);
            }
            y = tmpInput.substring(0, 2);
        c++:
            char x;
            char * y = "";
            std::string user_input;
            std::string tmp_input;
            int i;
            std::string data_type;
            std::getline(std::cin, user_input);
            i = 0;
            x = user_input[i++];
            tmp_input = "";
            data_type = "abcd";
            while (i < user_input.length() && data_type.find(user_input[i]) != std::string::npos) {
                tmp_input += user_input[i++];
            }
            y = tmp_input.substr(0, 2);
        main c:
            char x;
            char * y = "";
            scanf("%c%2[abcd]",  &x, y);


    case: LastSuppressedScan
        python:
            x: object
            user_input = input()
            i = 0
            x = user_input[i]
            i += 1
        java:
            char x;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            int i;
            userInput = scanner.nextLine();
            i = 0;
            x = userInput.charAt(i++);
        c++:
            char x;
            std::string user_input;
            int i;
            std::getline(std::cin, user_input);
            i = 0;
            x = user_input[i++];
        main c:
            char x;
            scanf("%c%*[abcd]",  &x);


    case: LastSkip
        python:
            a: object
            user_input = input()
            i = 0
            a = user_input[i]
            i += 1
        java:
            char a;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            int i;
            userInput = scanner.nextLine();
            i = 0;
            a = userInput.charAt(i++);
        c++:
            char a;
            std::string user_input;
            int i;
            std::getline(std::cin, user_input);
            i = 0;
            a = user_input[i++];
        main c:
            char a;
            scanf("%cabcd", &a);


group: PrintfTest
    case: SimpleInt
        isolated python:
            print(f"{1:d}", end="")
        java:
            System.out.printf("%d", 1);
        isolated c++:
            std::cout << std::format("{:d}", 1);
        c:
            printf("%d", 1);


    case: SimpleFloat
        isolated python:
            print(f"{1.01:f}", end="")
        java:
            System.out.printf("%f", 1.01);
        isolated c++:
            std::cout << std::format("{:f}", 1.01);
        c:
            printf("%f", 1.01);


    case: SimpleChar
        isolated python:
            print(f"{"t":c}", end="")
        java:
            System.out.printf("%c", 't');
        isolated c++:
            std::cout << std::format("{:c}", 't');
        c:
            printf("%c", 't');


    case: SimpleString
        isolated python:
            print(f"{"text":s}", end="")
