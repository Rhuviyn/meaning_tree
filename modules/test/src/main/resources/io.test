group: StringFormatTest
    case: Simple
        python:
            f"text{1:d}"
        java:
            String.format("text%d", 1);
        c++:
            std::format("text{:d}", 1);


    case: Modifiers
        python:
            f"text{100.001:+02.2d}"
        java:
            String.format("text%+02.2d", 100.001);
        c++:
            std::format("text{:+02.2d}", 100.001);


    case: NoSpecifier
        python:
            f"text{1}"
        isolated java:
            String.format("text%d", 1);
        c++:
            std::format("text{}", 1);


    case: Expression
        python:
            a: int = 1
            f"text{a + 1}"
        isolated java:
            int a = 1;
            String.format("text%d", a + 1);
        c++:
            int a = 1;
            std::format("text{}", a + 1);


    case: FewValues
        python:
            f"text{1:d}text{1.001:f}text{"value":s}"
        java:
            String.format("text%dtext%ftext%s", 1, 1.001, "value");
        c++:
            std::format("text{:d}text{:f}text{:s}", 1, 1.001, "value");


    case: PythonFormat
        main python:
            "text{}".format(1)
        java:
            String.format("text%d", 1);
        c++:
            std::format("text{}", 1);


    case: PythonFormatSpecifier
        main python:
            "text{:d}".format(1)
        java:
            String.format("text%d", 1);
        c++:
            std::format("text{:d}", 1);


    case: PythonCStyleFewValues
        main python:
            "text%dtext%ftext%s" % (1, 1.001, "value")
        java:
            String.format("text%dtext%ftext%s", 1, 1.001, "value");
        c++:
            std::format("text{:d}text{:f}text{:s}", 1, 1.001, "value");


    case: JavaFormatted
        python:
            f"text{1:d}"
        main java:
            "text%d".formatted(1);
        c++:
            std::format("text{:d}", 1);


    case: JavaFormattedFewValues
        python:
            f"text{1:d}text{1.001:f}text{"value":s}"
        main java:
            "text%dtext%ftext%s".formatted(1, 1.001, "value");
        c++:
            std::format("text{:d}text{:f}text{:s}", 1, 1.001, "value");


group: ImportTest
    case[translationUnitMode="procedural"]: Input
        python:
            print(1, end="")
        java:
