group: PythonInputTest
    case: Int
        main python:
            a = int(input())
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            var a = scanner.nextInt();
        c++:
            auto a;
            std::cin >> a;
        c:
            auto a;
            scanf("%d", &a);


    case: Float
        main python:
            a = float(input())
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            var a = scanner.nextFloat();
        c++:
            auto a;
            std::cin >> a;
        c:
            auto a;
            scanf("%f", &a);


    case: String
        main python:
            a = input()
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            var a = scanner.nextLine();
        c++:
            auto a;
            std::getline(std::cin, a);
        c:
            auto a;
            gets(a);


    case: StringStr
        main python:
            a = str(input())
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            var a = scanner.nextLine();
        c++:
            auto a;
            std::getline(std::cin, a);
        c:
            auto a;
            gets(a);


    case: PromptString
        main python:
            a = input("prompt")
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            System.out.print("prompt");
            var a = scanner.nextLine();
        c++:
            auto a;
            std::cout << "prompt";
            std::getline(std::cin, a);
        c:
            auto a;
            printf("prompt");
            gets(a);


    case: PromptInt
        main python:
            a = input(1)
        java:
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            System.out.print(1);
            var a = scanner.nextLine();
        c++:
            auto a;
            std::cout << 1;
            std::getline(std::cin, a);
        c:
            auto a;
            printf("%d", 1);
            gets(a);


    case: PromptVariable
        main python:
            prompt = 1
            a = input(prompt)
        java:
            int prompt = 1;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            System.out.print(prompt);
            var a = scanner.nextLine();
        c++:
            int prompt = 1;
            auto a;
            std::cout << prompt;
            std::getline(std::cin, a);
        c:
            int prompt = 1;
            auto a;
            printf("%d", prompt);
            gets(a);


group: PythonOutputTest
    case: SimplePrint
        main python:
            print("data")
        java:
            System.out.println("data");
        c++:
            std::cout << "data" << std::endl;
        c:
            printf("%s\n", "data");


    case: PrintVariable
        main python:
            data = 1
            print(data)
        java:
            int data = 1;
            System.out.println(data);
        c++:
            int data = 1;
            std::cout << data << std::endl;
        c:
            int data = 1;
            printf("%d\n", data);


    case: PrintFew
        main python:
            print("data1", "data2")
        java:
            System.out.println("" + "data1" + " " + "data2");
        c++:
            std::cout << "data1" << " " << "data2" << std::endl;
        c:
            printf("%s %s\n", "data1", "data2");


    case: PrintFewWithFormat
        main python:
            print("data1", f"text{40:1d}", "data2")
        java:
            System.out.println("" + "data1" + " " + (String.format("text%1d", 40)) + " " + "data2");
        c++:
            std::cout << "data1" << " " << std::format("text{:1d}", 40) << " " << "data2" << std::endl;
        c:
            printf("%s text%1d %s\n", "data1", 40, "data2");


    case: EndString
        main python:
            print("data1", "data2", end = "*")
        java:
            System.out.print("" + "data1" + " " + "data2" + "*");
        c++:
            std::cout << "data1" << " " << "data2" << "*";
        c:
            printf("%s %s*", "data1", "data2");


    case: EndInt
        main python:
            print("data1", "data2", end = 1)
        java:
            System.out.print("" + "data1" + " " + "data2" + 1);
        c++:
            std::cout << "data1" << " " << "data2" << 1;
        c:
            printf("%s %s%d", "data1", "data2", 1);


    case: EndVariable
        main python:
            ender = 1
            print("data1", "data2", end = ender)
        java:
            int ender = 1;
            System.out.print("" + "data1" + " " + "data2" + ender);
        c++:
            int ender = 1;
            std::cout << "data1" << " " << "data2" << ender;
        c:
            int ender = 1;
            printf("%s %s%d", "data1", "data2", ender);


    case: EndEmpty
        main python:
            print("data1", "data2", end = "")
        java:
            System.out.print("" + "data1" + " " + "data2");
        c++:
            std::cout << "data1" << " " << "data2";
        c:
            printf("%s %s", "data1", "data2");


    case: SepString
        main python:
            print("data1", "data2", sep = "*")
        java:
            System.out.println("" + "data1" + "*" + "data2");
        c++:
            std::cout << "data1" << "*" << "data2" << std::endl;
        c:
            printf("%s*%s\n", "data1", "data2");


    case: SepInt
        main python:
            print("data1", "data2", sep = 1)
        java:
            System.out.println("" + "data1" + 1 + "data2");
        c++:
            std::cout << "data1" << 1 << "data2" << std::endl;
        c:
            printf("%s%d%s\n", "data1", 1, "data2");


    case: SepVariable
        main python:
            separator = 1
            print("data1", "data2", sep = separator)
        java:
            int separator = 1;
            System.out.println("" + "data1" + separator + "data2");
        c++:
            int separator = 1;
            std::cout << "data1" << separator << "data2" << std::endl;
        c:
            int separator = 1;
            printf("%s%d%s\n", "data1", separator, "data2");


    case: SepEmpty
        main python:
            print("data1", "data2", sep = "")
        java:
            System.out.println("" + "data1" + "data2");
        c++:
            std::cout << "data1" << "data2" << std::endl;
        c:
            printf("%s%s\n", "data1", "data2");


    case: SepMany
        main python:
            print("data1", "data2", "data3", sep = "*")
        java:
            System.out.println("" + "data1" + "*" + "data2" + "*" + "data3");
        c++:
            std::cout << "data1" << "*" << "data2" << "*" << "data3" << std::endl;
        c:
            printf("%s*%s*%s\n", "data1", "data2", "data3");


    case: SepEnd
        main python:
            print("data1", "data2", sep = "*", end = "?")
        java:
            System.out.print("" + "data1" + "*" + "data2" + "?");
        c++:
            std::cout << "data1" << "*" << "data2" << "?";
        c:
            printf("%s*%s?", "data1", "data2");


    case: PrintFormat
        main python:
            print("text {}".format("data"))
        java:
            System.out.println(String.format("text %s", "data"));
        c++:
            std::cout << std::format("text {}", "data") << std::endl;
        c:
            printf("text %s\n", "data");


    case: PrintFormatted
        main python:
            print("text %s" % "data")
        java:
            System.out.println(String.format("text %s", "data"));
        c++:
            std::cout << std::format("text {:s}", "data") << std::endl;
        c:
            printf("text %s\n", "data");


    case: PrintFormattedFew
        main python:
            print("text %s %d" % ("data", 1))
        java:
            System.out.println(String.format("text %s %d", "data", 1));
        c++:
            std::cout << std::format("text {:s} {:d}", "data", 1) << std::endl;
        c:
            printf("text %s %d\n", "data", 1);


