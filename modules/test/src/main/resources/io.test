            scanf("%s", a);


    case: LineJavaToC
        main java:
            String a;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            a = scanner.nextLine();
        c:
            char16_t * a;
            gets(a);


    case: LineCppToC
        main c++:
            std::string a;
            std::getline(std::cin, a);
        c:
            char * a;
            gets(a);


    case: FewValuesCin
        python:
            a: int
            b: float
            c: object
            d: str
            a = int(input())
            b = float(input())
            c = input()[0]
            d = input()
        java:
            int a;
            float b;
            char c;
            String d;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            a = scanner.nextInt();
            b = scanner.nextFloat();
            c = scanner.next().charAt(0);
            d = scanner.next();
        main c++:
            int a;
            float b;
            char c;
            std::string d;
            std::cin >> a >> b >> c >> d;
        c:
            int a;
            float b;
            char c;
            char * d;
            scanf("%d%f%c%s", &a, &b, &c, d);


group: GeneralOutputTest
    case: Int
        python:
            print(1, end="")
        java:
            System.out.print(1);
        c++:
            std::cout << 1;
        isolated c:
            printf("%d", 1);


    case: Float
        python:
            print(1.01, end="")
        java:
            System.out.print(1.01);
        c++:
            std::cout << 1.01;
        isolated c:
            printf("%f", 1.01);


    case: String
        python:
            print("text", end="")
        java:
            System.out.print("text");
        c++:
            std::cout << "text";
        isolated c:
            printf("%s", "text");


    case: Char
        isolated python:
            print("t", end="")
        java:
            System.out.print('t');
        c++:
            std::cout << 't';
        isolated c:
            printf("%c", 't');


    case: Variable
        python:
            a: int = 1
            print(a, end="")
        java:
            int a = 1;
            System.out.print(a);
        c++:
            int a = 1;
            std::cout << a;
        isolated c:
            int a = 1;
            printf("%d", a);


    case: FewValuesCout
        python:
            print(1, 1.01, "text", "t", sep="", end="")
        java:
            System.out.print("" + 1 + 1.01 + "text" + 't');
        main c++:
            std::cout << 1 << 1.01 << "text" << 't';
        c:
            printf("%d%f%s%c", 1, 1.01, "text", 't');


    case: NewLine
        python:
            print(1)
        java:
            System.out.println(1);
        c++:
            std::cout << 1 << std::endl;
        isolated c:
            printf("%d\n", 1);


group: ScanfTest
    case: SingleSimpleInt
        python:
            a: int
            a = int(input())
        java:
            int a;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            a = scanner.nextInt();
        c++:
            int a;
            std::cin >> a;
        main c:
            #include <stdio.h>
            int a;
            scanf("%d", &a);


    case: SingleWidthInt
        python:
            a: int
            a = int(input()[:2])
        java:
            int a;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            a = Integer.parseInt(scanner.next().substring(0, 2));
        c++:
            int a;
            std::string user_input;
            std::getline(std::cin, user_input);
            a = stoi(user_input.substr(0, 2));
        main c:
            int a;
            scanf("%2d", &a);


    case: SingleSuppressInt
        python:
            tmp = int(input())
        java:
