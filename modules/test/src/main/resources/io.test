    case: SingleSimpleScan
        python:
            x: str = ""
            user_input = input()
            i = 0
            tmp_input = ""
            data_type = "abcd"
            while i < len(user_input) and user_input[i] in data_type:
                tmp_input += user_input[i]
                i += 1
            x = tmp_input
        java:
            String x = "";
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            String tmpInput;
            int i;
            String dataType;
            userInput = scanner.nextLine();
            i = 0;
            tmpInput = "";
            dataType = "abcd";
            while (i < userInput.length() && dataType.indexOf(userInput.charAt(i)) != -1) {
                tmpInput += userInput.charAt(i++);
            }
            x = tmpInput;
        c++:
            char * x = "";
            std::string user_input;
            std::string tmp_input;
            int i;
            std::string data_type;
            std::getline(std::cin, user_input);
            i = 0;
            tmp_input = "";
            data_type = "abcd";
            while (i < user_input.length() && data_type.find(user_input[i]) != std::string::npos) {
                tmp_input += user_input[i++];
            }
            x = tmp_input;
        main c:
            char * x = "";
            scanf("%[abcd]", x);


    case: SingleNegatedScan
        python:
            x: str = ""
            user_input = input()
            i = 0
            tmp_input = ""
            data_type = "abcd"
            while i < len(user_input) and user_input[i] not in data_type:
                tmp_input += user_input[i]
                i += 1
            x = tmp_input
        java:
            String x = "";
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            String tmpInput;
            int i;
            String dataType;
            userInput = scanner.nextLine();
            i = 0;
            tmpInput = "";
            dataType = "abcd";
            while (i < userInput.length() && dataType.indexOf(userInput.charAt(i)) == -1) {
                tmpInput += userInput.charAt(i++);
            }
            x = tmpInput;
        c++:
            char * x = "";
            std::string user_input;
            std::string tmp_input;
            int i;
            std::string data_type;
            std::getline(std::cin, user_input);
            i = 0;
            tmp_input = "";
            data_type = "abcd";
            while (i < user_input.length() && data_type.find(user_input[i]) == std::string::npos) {
                tmp_input += user_input[i++];
            }
