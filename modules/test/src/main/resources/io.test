    case: MiddleSimpleFloat
        python:
            a: float
            b: object
            user_input = input()
            i = 0
            tmp_input = ""
            data_type = "0123456789.eE+-"
            if user_input[i] == 'e' or user_input[i] == 'E':
                data_type = ""
            if user_input[i] == '-' or user_input[i] == '+':
                tmp_input += user_input[i]
                i += 1
            while i < len(user_input) and user_input[i] in data_type:
                tmp_input += user_input[i]
                if user_input[i] == '.':
                    data_type = data_type.replace(".", "")
                elif user_input[i] == 'e' or user_input[i] == 'E':
                    data_type = data_type.replace(".", "")
                    data_type = data_type.replace("e", "")
                    data_type = data_type.replace("E", "")
                elif user_input[i] == '+' or user_input[i] == '-':
                    if user_input[i - 1] == 'e' or user_input[i - 1] == 'E':
                        data_type = data_type.replace("+", "")
                        data_type = data_type.replace("-", "")
                    else:
                        tmp_input = tmp_input[:i]
                        i -= 1
                        data_type = ""
                i += 1
            a = float(tmp_input)
            b = user_input[i]
        java:
            float a;
            char b;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            String userInput;
            String tmpInput;
            int i;
            String dataType;
            userInput = scanner.nextLine();
            i = 0;
            tmpInput = "";
            dataType = "0123456789.eE+-";
            if (userInput.charAt(i) == 'e' || userInput.charAt(i) == 'E') {
                dataType = "";
            }
            if (userInput.charAt(i) == '-' || userInput.charAt(i) == '+') {
                tmpInput += userInput.charAt(i++);
            }
            while (i < userInput.length() && dataType.indexOf(userInput.charAt(i)) != -1) {
                tmpInput += userInput.charAt(i);
                if (userInput.charAt(i) == '.') {
                    dataType.replace(".", "");
                } else if (userInput.charAt(i) == 'e' || userInput.charAt(i) == 'E') {
                    dataType.replace(".", "");
                    dataType.replace("e", "");
                    dataType.replace("E", "");
                } else if (userInput.charAt(i) == '+' || userInput.charAt(i) == '-') {
                    if (userInput.charAt(i - 1) == 'e' || userInput.charAt(i - 1) == 'E') {
                        dataType.replace("+", "");
                        dataType.replace("-", "");
                    } else {
                        tmpInput = tmpInput.substring(0, i--);
                        dataType = "";
                    }
                }
                i++;
            }
            a = Float.parseFloat(tmpInput);
            b = userInput.charAt(i);
        c++:
            float a;
            char b;
            std::cin >> a >> b;
        main c:
            float a;
