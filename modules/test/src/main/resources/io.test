            printf("%d", 1);


    case[translationUnitMode="procedural"]: CToCppInput
        c++:
            #include <iostream>
            int a;
            std::cin >> a;
        main c:
            #include <stdio.h>
            int a;
            scanf("%d", &a);


    case[translationUnitMode="procedural"]: Output
        python:
            a: int = 1
            a = int(input())
        java:
            int a = 1;
            java.util.Scanner scanner = new java.util.Scanner(System.in);
            a = scanner.nextInt();
        c++:
            #include <iostream>
            int a = 1;
            std::cin >> a;
        c:
            #include <stdio.h>
            int a = 1;
            scanf("%d", &a);


    case[translationUnitMode="procedural"]: Format
        python:
            f"text{1:d}"
        java:
            String.format("text%d", 1);
        c++:
            #include <format>
            std::format("text{:d}", 1);


    case[translationUnitMode="procedural"]: Scanner
        python:
            a: int
            a = int(input())
        main java:
            import java.util.Scanner;
            int a;
            Scanner scanner = new Scanner(System.in);
            a = scanner.nextInt();
        c++:
            #include <iostream>
            int a;
            std::cin >> a;
        c:
            #include <stdio.h>
            int a;
            scanf("%d", &a);






